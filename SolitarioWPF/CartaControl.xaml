<UserControl x:Class="SolitarioWPF.CartaControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="90"
             Height="125">

	<Border Background="White"
            BorderBrush="#333333"
            BorderThickness="1"
            CornerRadius="8"
            Padding="6">

		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<StackPanel Grid.Row="0">
				<TextBlock x:Name="TxtValor"
                           FontSize="20"
                           FontWeight="Bold"/>

				<TextBlock x:Name="TxtPalo"
                           FontSize="18"/>
			</StackPanel>

			<TextBlock x:Name="TxtPaloCentral"
                       Grid.Row="1"
                       FontSize="42"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

		</Grid>

	</Border>

</UserControl>