<Window x:Class="Solitario.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Solitario"
        Height="750"
        Width="1200"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#155B43">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0"
                   Text="SOLITARIO"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,30"/>

        <!-- Zona superior: mazo y fundaciones -->
        <Grid Grid.Row="1" Margin="0,0,0,45">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Mazo -->
            <Border Grid.Column="0"
                    Width="90"
                    Height="125"
                    BorderBrush="White"
                    BorderThickness="2"
                    CornerRadius="8"
                    Background="#174C91"/>

            <!-- Descarte -->
            <Border Grid.Column="1"
                    Width="90"
                    Height="125"
                    BorderBrush="White"
                    BorderThickness="2"
                    CornerRadius="8"
                    Background="#FFFFFF"
                    Opacity="0.25"/>

            <!-- Fundaciones -->
            <ItemsControl Grid.Column="3"
                          Grid.ColumnSpan="4">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.Items>
                    <Border Width="90" Height="125"
                            BorderBrush="White"
                            BorderThickness="2"
                            CornerRadius="8"
                            Background="Transparent"
                            Opacity="0.5"/>

                    <Border Width="90" Height="125"
                            BorderBrush="White"
                            BorderThickness="2"
                            CornerRadius="8"
                            Background="Transparent"
                            Opacity="0.5"/>

                    <Border Width="90" Height="125"
                            BorderBrush="White"
                            BorderThickness="2"
                            CornerRadius="8"
                            Background="Transparent"
                            Opacity="0.5"/>

                    <Border Width="90" Height="125"
                            BorderBrush="White"
                            BorderThickness="2"
                            CornerRadius="8"
                            Background="Transparent"
                            Opacity="0.5"/>
                </ItemsControl.Items>

            </ItemsControl>

        </Grid>

        <!-- Zona inferior: columnas -->
        <UniformGrid Grid.Row="2"
                     Rows="1"
                     Columns="7"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Top">

            <Border Margin="5"
                    Background="#12533D"
                    CornerRadius="5"/>

            <Border Margin="5"
                    Background="#12533D"
                    CornerRadius="5"/>

            <Border Margin="5"
                    Background="#12533D"
                    CornerRadius="5"/>

            <Border Margin="5"
                    Background="#12533D"
                    CornerRadius="5"/>

            <Border Margin="5"
                    Background="#12533D"
                    CornerRadius="5"/>

            <Border Margin="5"
                    Background="#12533D"
                    CornerRadius="5"/>

            <Border Margin="5"
                    Background="#12533D"
                    CornerRadius="5"/>

        </UniformGrid>

    </Grid>

</Window>